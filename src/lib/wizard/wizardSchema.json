  "stepFields": {
    "type": [
      {
        "key": "incidentType",
        "label": "Incident type",
        "kind": "choice",
        "options": "INCIDENT_TYPES",
        "required": true
      }
    ],
    "position": [
      {
        "key": "positionKnown",
        "label": "Is the exact location known?",
        "kind": "yesno",
        "required": true,
        "yes": "Exact location known",
        "no": "Approximate area only"
      },
      {
        "key": "lkp",
        "label": "Last known position",
        "kind": "position",
        "lat": "lkpLat",
        "lng": "lkpLng",
