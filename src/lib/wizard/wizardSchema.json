          "positionKnown": true
        },
        "required": true
      },
      {
        "key": "areaDescription",
        "label": "Area description",
        "kind": "textarea",
        "when": {
          "positionKnown": false
        },
        "requiredAnyOf": [
          "areaDescription",
          "lkp"
        ]
      },
      {
        "key": "lkp",
        "label": "Area centre (optional)",
        "kind": "position",
        "lat": "lkpLat",
        "lng": "lkpLng",
